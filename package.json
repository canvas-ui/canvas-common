{
  "name": "canvas-common",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build:dev",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint . --no-error-on-unmatched-pattern && pnpm -r --if-present --filter '!canvas-common' run lint",
    "format": "prettier --write \"packages/**/*.{js,md,json}\"",
    "publish:npm": "node scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  },
  "version": "0.2.1"
}
