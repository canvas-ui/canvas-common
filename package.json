    "@slack/web-api": "^7.15.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "cacache": "^20.0.4",
    "canvas-stored": "github:canvas-ui/canvas-stored#main",
    "canvas-synapsd": "git+https://github.com/canvas-ui/canvas-synapsd.git#main",
    "conf": "^14.0.0",
