{
  "name": "canvas-common",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build:dev",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint . --no-error-on-unmatched-pattern && pnpm -r --if-present --filter '!canvas-common' run lint",
    "format": "prettier --write \"packages/**/*.{js,md,json}\"",
    "publish:npm": "node scripts/publish-npm.mjs",
    "runtime:refresh": "node scripts/regenerate-runtime-core.mjs",
    "runtime:check": "node scripts/regenerate-runtime-core.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "acorn": "^8.19.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  },
  "version": "0.3.26",
  "exports": {
    "./*": "./packages/runtime-core/src/*",
    "./host": "./packages/runtime-core/src/runtimes/workspace/runtime/host.js"
  },
  "bin": {
    "canvas-workspace": "runtimes/workspaced/bin/canvas-workspace.js"
  },
  "files": [
    "packages/runtime-core/src",
    "runtimes/workspaced/src",
    "runtimes/workspaced/bin",
    "runtimes/workspaced/deploy",
    "runtimes/workspaced/README.md",
    "NOTICE",
    "packages/runtime-core/package.json",
    "runtimes/workspaced/package.json"
  ],
  "dependencies": {
    "@augmentd-labs/canvas-protocol": "^0.4.0",
    "@augmentd-labs/canvas-web": "^2.15.0",
    "@fastify/error": "^3.4.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/static": "^6.12.0",
    "@napi-rs/canvas": "^1.0.6",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "canvas-stored": "github:canvas-ui/canvas-stored#main",
    "canvas-synapsd": "github:canvas-ui/canvas-synapsd#main",
    "conf": "^14.0.0",
    "debug": "^4.4.3",
    "dotenv": "^17.3.1",
    "eventemitter2": "^6.4.9",
    "fastify": "^4.29.1",
    "fastify-socket.io": "^5.1.0",
    "get-folder-size": "^5.0.0",
    "html-to-text": "^10.0.1",
    "imap": "^0.8.19",
    "imapflow": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "ldapjs": "^3.0.7",
    "mailparser": "^3.9.9",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^6.2.108",
    "pino": "^10.3.1",
    "qrcode": "1.5.4",
    "randomcolor": "^0.6.2",
    "sharp": "^0.35.3",
    "undici": "^8.7.0",
    "uuid": "^11.1.1",
    "@augmentd-labs/canvas-agent-runtime": "^0.1.0"
  }
}
